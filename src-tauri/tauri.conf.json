{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Too Many Terminals",
  "version": "0.10.0",
  "identifier": "com.exoutils.too-many-terminals",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Too Many Terminals",
        "width": 1280,
        "height": 800,
        "minWidth": 700,
        "minHeight": 450,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
